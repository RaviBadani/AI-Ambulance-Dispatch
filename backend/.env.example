# ==========================================
# AI Ambulance Dispatch - Environment Configuration
# ==========================================

# Core Application Settings
PROJECT_NAME="AI Emergency Ambulance Dispatch"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./sql_app.db"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://localhost:80"

# Jira Automation Integration (Optional)
# Set JIRA_ENABLED=true to enable automatic incident issue creation
JIRA_ENABLED=false
JIRA_SERVER="https://your-domain.atlassian.net"
JIRA_EMAIL="your-atlassian-account@company.com"
JIRA_API_TOKEN="your-jira-api-token-from-id.atlassian.com"
JIRA_PROJECT_KEY="AMB"

